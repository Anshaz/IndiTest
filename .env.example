# Copy this file to .env for local testing (never commit .env itself):
#   cp .env.example .env
# then edit .env with your real key(s), and run e.g.:
#   node --env-file=.env scripts/scan.mjs
#   node --env-file=.env scripts/fetch_squeeze_scores.mjs
#
# In production this isn't used at all — the GitHub Action reads these
# from repo secrets (Settings → Secrets and variables → Actions), not
# from a file. .env only saves you re-typing the key for local runs.

TWELVEDATA_API_KEY=your_key_here
EQUIBLES_API_KEY=your_key_here
