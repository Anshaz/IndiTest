# Copy this file to .env for local testing (never commit .env itself):
#   cp .env.example .env
# then edit .env with your real key, and run e.g.:
#   node --env-file=.env scripts/scan.mjs
#   node --env-file=.env scripts/backtest.mjs
#
# In production this isn't used at all — the GitHub Action reads
# TWELVEDATA_API_KEY from a repo secret (Settings → Secrets and
# variables → Actions), not from a file.

TWELVEDATA_API_KEY=your_key_here
